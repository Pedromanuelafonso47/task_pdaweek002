# Base de dados (npm run db:start arranca um PostgreSQL embutido em 54329)
DATABASE_URL="postgresql://postgres:agrogenius@localhost:54329/agrogenius?schema=public"

PORT=4000
WEB_ORIGIN=http://localhost:3000

# JWT — gera valores longos e aleatórios em produção
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# MQTT (opcional — sem URL, o módulo IoT funciona via HTTP e regista que o broker não está configurado)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Agro AI (opcional — sem chave, o assistente usa o modo baseado em regras, identificado na interface)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Redis (opcional)
REDIS_URL=
